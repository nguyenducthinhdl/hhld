# Copy to a 0600 file outside git (e.g. ~/.config/hhld/local.env) and fill locally.
# Never commit real values. HHLD does not read this file; export the vars yourself.

# Local loop / paper-live: keep HHLD_VENUE_ENV=local (or unset) and HHLD_LIVE_ORDERS=0.
# For hhld-place -env testnet|staging: export HHLD_VENUE_ENV=testnet (or unset) and
# HHLD_LIVE_ORDERS=1. A .env that leaves HHLD_VENUE_ENV=local will fail the env pin
# when you pass -env testnet.

HHLD_LIVE_ORDERS=0
HHLD_VENUE_ENV=local
HHLD_KILL=0

HL_ACCOUNT_ADDRESS=
HL_TESTNET_PRIVATE_KEY=
HL_MAINNET_PRIVATE_KEY=

GRVT_STAGING_API_KEY=
GRVT_STAGING_SUB_ACCOUNT_ID=
GRVT_STAGING_SIGNING_KEY=
GRVT_TESTNET_API_KEY=
GRVT_TESTNET_SUB_ACCOUNT_ID=
GRVT_TESTNET_SIGNING_KEY=
GRVT_PROD_API_KEY=
GRVT_PROD_SUB_ACCOUNT_ID=
GRVT_PROD_SIGNING_KEY=
